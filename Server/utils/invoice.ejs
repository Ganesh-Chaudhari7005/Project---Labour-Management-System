<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">

<style>
@page {
  size: A4;
  margin: 0;
}

body {
  font-family: Arial, sans-serif;
  margin: 0;
  background: white;
}

.page {
  width: 210mm;
  min-height: 297mm;
  padding: 12mm;
  box-sizing: border-box;
}

.header {
  text-align: center;
  border-bottom: 2px solid black;
  padding-bottom: 10px;
}

.company-name {
  font-size: 28px;
  font-weight: bold;
}

.company-info {
  font-size: 14px;
  margin-top: 5px;
}

.invoice-title {
  text-align: center;
  font-size: 24px;
  font-weight: bold;
  margin: 20px 0;
  text-decoration: underline;
}

.bill-details {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15px;
}

.client-box {
  border: 1px solid black;
  padding: 10px;
  margin-bottom: 15px;
}

.client-box p {
  margin: 5px 0;
}

table {
  width: 100%;
  border-collapse: collapse;
}

table,
th,
td {
  border: 1px solid black;
}

th {
  background: #f0f0f0;
  text-align: center;
  padding: 8px;
}

td {
  padding: 8px;
}

.summary {
  width: 40%;
  margin-left: auto;
  margin-top: 15px;
}

.summary table {
  width: 100%;
}

.total-row {
  font-weight: bold;
  background: #f0f0f0;
}

.amount-words {
  margin-top: 20px;
  border: 1px solid black;
  padding: 10px;
}

.terms {
  margin-top: 20px;
  border: 1px solid black;
  padding: 10px;
}

.signature {
  text-align: right;
  margin-top: 70px;
}

.signature-line {
  margin-top: 40px;
}

.footer {
  margin-top: 30px;
  font-size: 12px;
  text-align: center;
}
.system-note {
  margin-top: 60px;
  text-align: right;
  font-size: 13px;
  line-height: 1.6;
}

.system-note em {
  color: #555;
}
.right {
  text-align: right;
}

.center {
  text-align: center;
}
</style>
</head>

<body>

<div class="page">

  <div class="header">
    <div class="company-name">ROYAL ENTERPRISES</div>

    <div class="company-info">
      Dhayari, Pune, Maharashtra<br>

      <strong>PAN NO :</strong> BHKPC4354F<br>

      <strong>GSTIN/UIN :</strong> 27BHKPC4354F1ZH
    </div>
  </div>

  <div class="invoice-title">
    Bill
  </div>

  <div class="bill-details">
    <div>
      <strong>Bill No :</strong>
      <%= billno %>
    </div>

    <div>
      <strong>Date :</strong>
      <%= date %>
    </div>
  </div>

  <div class="client-box">
    <strong>Bill To :</strong>

    <p><strong><%= clientName %></strong></p>

    <p><%= siteAddr %></p>
  </div>

  <table>

    <thead>
      <tr>
        <th>Sr. No.</th>
        <th>Description</th>
        <th>Area</th>
        <th>Rate (₹)</th>
        <th>Amount (₹)</th>
      </tr>
    </thead>

    <tbody>

      <% items.forEach((item, index) => { %>
      <tr>
        <td class="center"><%= index + 1 %></td>
        <td><%= item.name %></td>
        <td class="center"><%= item.area %></td>
        <td class="right"><%= item.rate %></td>
        <td class="right">
          <%= item.total.toLocaleString("en-IN") %>
        </td>
      </tr>
      <% }) %>

      <% customRows.forEach((item, index) => { %>
      <tr>
        <td class="center">
          <%= items.length + index + 1 %>
        </td>

        <td><%= item.Desc %></td>

        <td class="center">
          <%= item.Area %>
        </td>

        <td class="right">
          <%= item.Rate %>
        </td>

        <td class="right">
          <%= (item.Area * item.Rate).toLocaleString("en-IN") %>
        </td>
      </tr>
      <% }) %>

    </tbody>

  </table>

  <div class="summary">
    <table>

      <tr>
        <td>Subtotal</td>
        <td class="right">
          ₹ <%= subtotal.toLocaleString("en-IN") %>
        </td>
      </tr>

      <tr>
        <td>GST (18%)</td>
        <td class="right">
          ₹ <%= gst.toLocaleString("en-IN") %>
        </td>
      </tr>

      <tr class="total-row">
        <td>Grand Total</td>
        <td class="right">
          ₹ <%= grandTotal.toLocaleString("en-IN") %>
        </td>
      </tr>

    </table>
  </div>

  <div class="amount-words">
    <strong>Amount In Words :</strong><br><br>

    <%= amountInWords %>
  </div>

  <div class="system-note">
  For <strong>Royal Enterprises</strong><br><br>

  <em>
    This is a computer-generated invoice and does not require a physical signature.
  </em>
</div>



</div>

</body>
</html>