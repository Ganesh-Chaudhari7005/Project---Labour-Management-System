<!DOCTYPE html>
<html>
<head>
  <style>
    body {
      font-family: Arial;
      padding: 20px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      border: 1px solid #000;
      padding: 8px;
    }

    h2 {
      text-align: center;
    }
  </style>
</head>
<body>

<h2>Supervisor Attendance Report</h2>

<p>
  <strong>Supervisor:</strong>
  <%= supervisorName %>
</p>

<table>
  <thead>
    <tr>
      <th>Sr No</th>
      <th>Date</th>
      <th>Supervisor</th>
      <th>Status</th>
      <th>Working Site</th>
    </tr>
  </thead>

  <tbody>
    <% report.forEach((r,index)=> { %>
      <tr>
        <td><%= index + 1 %></td>
        <td><%= r.AttendanceDate %></td>
        <td><%= r.Name %></td>
        <td><%= r.Status %></td>
        <td><%= r.Site || '-' %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

</body>
</html>